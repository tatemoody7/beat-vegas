{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/hooks/pre_bash.sh\"",
            "timeout": 300,
            "statusMessage": "push/merge gate"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/hooks/post_edit.sh\"",
            "timeout": 120,
            "statusMessage": "ruff / matching tests / tsc"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/hooks/on_stop.sh\"",
            "timeout": 300,
            "statusMessage": "full pytest + vitest + tsc"
          }
        ]
      }
    ]
  }
}
