__pycache__/
*.pyc
.venv/
venv/
data/*.db
data/*.db-journal
data/*.bak-*
data/*.log
data/cache/
# also the bare name: a dev SYMLINK to the main checkout's cache is not a
# directory, so the trailing-slash pattern above does not match it and it
# shows up as an untracked entry a `git add -A` would sweep in.
data/cache
data/pbp_cache/
data/pg_sim/
# Friday bet-card reasoning (local, per-week)
data/cards/
# Node / Next.js (web/ app, added in later phases)
node_modules/
.next/
.env
.env.local
.env*.local
*.egg-info/
.pytest_cache/
config.yaml
.DS_Store

# Local agent tooling (not part of the project)
.claude/
# ...except the shared dev-server config, which is deliberately tracked so a
# fresh clone can start the app. gitignore does not apply to already-tracked
# files, so without this negation the file's tracked state and this rule said
# opposite things and only `git ls-files` revealed which one was true.
!.claude/launch.json
.superpowers/

# Deploy-and-verify poller state (local, per-machine)
/.deploy-verify/
.vercel
.env*

# Gate reports (timestamped; the workflows upload them as artifacts). The
# FINDING is committed to docs/ -- see docs/LEVEL_ANCHOR.md -- never the file.
reports/residual_gate_*
reports/level_anchor_*
reports/censoring_*
reports/two_sided_*

# Agent research scratch output (swarm dossiers, residual-gate CSV/JSON dumps).
# It was untracked AND unignored, so a `git add -A` would have swept several MB
# of it into a commit. `reports/residual_gate_*` above covers the sibling path
# but never this one.
/research/
