<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.beatvegas.sunday-notify</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/tatemoody/Desktop/Beat Vegas/scripts/run_sunday.sh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/tatemoody/Desktop/Beat Vegas</string>
    <!-- Sundays 12:45pm local: a few minutes after the cloud capture+score job
         (.github/workflows/sunday.yml) so the board is updated before we text.
         Notify-only; no DB/Neon access. Runs only while the Mac is awake. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>0</integer>
        <key>Hour</key>
        <integer>12</integer>
        <key>Minute</key>
        <integer>45</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>/Users/tatemoody/Desktop/Beat Vegas/data/sunday-notify.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/tatemoody/Desktop/Beat Vegas/data/sunday-notify.err.log</string>
</dict>
</plist>
