generator client {
  provider = "prisma-client-js"
}

// The connection URL lives in prisma.config.ts (Prisma 7).
datasource db {
  provider = "postgresql"
}

model bv_adjustments {
  id         Int       @id @default(autoincrement())
  game_id    Int?
  delta_pts  Float?
  reason     String?   @db.VarChar
  created_at DateTime? @db.Timestamp(6)

  @@index([game_id], map: "ix_bv_adjustments_game_id")
}

model games {
  id                     Int              @id(map: "uq_game_id") @default(autoincrement())
  season                 Int
  week                   Int
  season_type            String?          @db.VarChar
  start_date             DateTime?        @db.Timestamp(6)
  neutral_site           Boolean?
  venue_id               Int?
  home_team              String?          @db.VarChar
  away_team              String?          @db.VarChar
  home_team_id           Int?
  away_team_id           Int?
  home_points            Int?
  away_points            Int?
  home_first_half_points Int?
  away_first_half_points Int?
  first_half_total       Int?
  first_half_source      String?          @db.VarChar
  full_game_total        Float?
  full_game_total_book   String?          @db.VarChar
  home_conference        String?          @db.VarChar
  away_conference        String?          @db.VarChar
  spread                 Float?
  venues                 venues?          @relation(fields: [venue_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  manual_picks           manual_picks[]
  odds_snapshots         odds_snapshots[]
  predictions            predictions[]
  results                results[]
  weather                weather?

  @@index([week], map: "ix_games_week")
  @@index([season], map: "ix_games_season")
  @@index([home_team], map: "ix_games_home_team")
  @@index([away_team], map: "ix_games_away_team")
}

model manual_picks {
  id                      Int       @id @default(autoincrement())
  game_id                 Int?
  season                  Int?
  week                    Int?
  home_team               String?   @db.VarChar
  away_team               String?   @db.VarChar
  side                    String?   @db.VarChar
  market                  String?   @db.VarChar
  line                    Float?
  price                   Int?
  stake                   Float?
  is_paper                Boolean?
  book                    String?   @db.VarChar
  placed_at               DateTime? @db.Timestamp(6)
  note                    String?   @db.VarChar
  model_score_at_pick     Int?
  model_line_at_pick      Float?
  factors_json_at_pick    String?   @db.VarChar
  opening_line            Float?
  graded                  Boolean?
  actual_first_half_total Int?
  result                  String?   @db.VarChar
  units                   Float?
  closing_line            Float?
  clv                     Float?
  clv_prob                Float?
  // Decision snapshot at log time (shared contract with scripts/pick.py; the
  // Python lane owns the SQL migration). reason: model_gap | price_edge | manual.
  verdict_at_pick         String?   @db.VarChar
  reason                  String?   @db.VarChar
  gap_at_pick             Float?
  ev_at_pick              Float?
  hr_line_at_pick         Float?
  blocker                 String?   @db.VarChar
  games                   games?    @relation(fields: [game_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  refit_id                Int?
  /// The registered protocol arm of a paper pick (docs/HYPOTHESES.md H-ARM-1HU; 2026-10-08).
  arm                     String?   @db.VarChar(16)

  @@index([season], map: "ix_manual_picks_season")
  @@index([game_id], map: "ix_manual_picks_game_id")
}

model model_runs {
  id           Int       @id @default(autoincrement())
  version      String?   @db.VarChar
  train_window String?   @db.VarChar
  test_window  String?   @db.VarChar
  metrics_json String?   @db.VarChar
  notes        String?   @db.VarChar
  created_at   DateTime? @db.Timestamp(6)

  @@index([version], map: "ix_model_runs_version")
}

model odds_snapshots {
  id           Int       @id @default(autoincrement())
  game_id      Int?
  book         String?   @db.VarChar
  market       String?   @db.VarChar
  line         Float?
  spread       Float?
  over_price   Int?
  under_price  Int?
  home_price   Int?
  away_price   Int?
  captured_at  DateTime? @db.Timestamp(6)
  last_seen_at DateTime? @db.Timestamp(6)
  games        games?    @relation(fields: [game_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([game_id, book, market, captured_at], map: "uq_odds_snapshot")
  @@index([captured_at], map: "ix_odds_snapshots_captured_at")
  @@index([game_id], map: "ix_odds_snapshots_game_id")
}

model predictions {
  id                         Int       @id @default(autoincrement())
  game_id                    Int?
  model_version              String?   @db.VarChar
  under_probability          Float?
  under_score                Int?
  projected_first_half_total Float?
  bv_line                    Float?
  bv_gap                     Float?
  bv_lo                      Float?
  bv_hi                      Float?
  bv_sigma                   Float?
  refit_id                   Int?
  fingerprint                String?   @db.VarChar
  line_used                  Float?
  rank                       Int?
  factors_json               String?   @db.VarChar
  created_at                 DateTime? @db.Timestamp(6)
  games                      games?    @relation(fields: [game_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([game_id], map: "ix_predictions_game_id")
  @@index([model_version], map: "ix_predictions_model_version")
}

model results {
  id                      Int       @id @default(autoincrement())
  game_id                 Int?
  model_version           String?   @db.VarChar
  market                  String?   @db.VarChar
  actual_first_half_total Int?
  line_used               Float?
  line_kind               String?   @db.VarChar
  under_hit               Boolean?
  closing_line            Float?
  closing_captured_at     DateTime? @db.Timestamp(6)
  clv                     Float?
  clv_prob                Float?
  units                   Float?
  games                   games?    @relation(fields: [game_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([game_id], map: "ix_results_game_id")
  @@index([model_version], map: "ix_results_model_version")
}

model team_tempo {
  id               Int       @id @default(autoincrement())
  season           Int?
  week             Int?
  team             String?   @db.VarChar
  seconds_per_play Float?
  plays_per_game   Float?
  as_of_date       String?   @db.VarChar
  captured_at      DateTime? @db.Timestamp(6)

  @@unique([season, week, team], map: "uq_tempo_week")
  @@index([team], map: "ix_team_tempo_team")
  @@index([season], map: "ix_team_tempo_season")
  @@index([week], map: "ix_team_tempo_week")
}

model team_week_features {
  id                Int    @id @default(autoincrement())
  season            Int
  week              Int
  team              String @db.VarChar
  seconds_per_play  Float?
  plays_per_game    Float?
  off_success_rate  Float?
  def_success_rate  Float?
  off_epa_per_play  Float?
  def_epa_per_play  Float?
  off_explosiveness Float?
  def_explosiveness Float?
  first_quarter_pf  Float?
  first_quarter_pa  Float?
  first_half_pf     Float?
  first_half_pa     Float?
  sp_overall        Float?
  sp_offense        Float?
  sp_defense        Float?
  run_rate          Float?

  @@unique([season, week, team], map: "uq_team_week")
  @@index([season], map: "ix_team_week_features_season")
  @@index([team], map: "ix_team_week_features_team")
  @@index([week], map: "ix_team_week_features_week")
}

model teams {
  id         Int     @id @default(autoincrement())
  school     String  @db.VarChar
  conference String? @db.VarChar

  @@index([school], map: "ix_teams_school")
}

model venues {
  id        Int      @id @default(autoincrement())
  name      String?  @db.VarChar
  city      String?  @db.VarChar
  state     String?  @db.VarChar
  latitude  Float?
  longitude Float?
  dome      Boolean?
  /// IANA zone from CFBD /venues (2026-10-17); null when CFBD has none
  timezone  String?  @db.VarChar
  games     games[]
}

model weather {
  game_id       Int      @id
  temperature_f Float?
  wind_mph      Float?
  precipitation Float?
  dome          Boolean?
  games         games    @relation(fields: [game_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

// arm_positions (2026-10-14, programme step 10): one row per registered
// hypothesis per Monday read, written only by the Monday workflow
// (beatvegas/positions.py). Hand-added, like every model here.
model arm_positions {
  id           Int       @id @default(autoincrement())
  hypothesis   String    @db.VarChar
  standard     String    @db.VarChar
  read_date    String    @db.VarChar
  read_at      DateTime  @db.Timestamp(6)
  run_id       String?   @db.VarChar
  state        String?   @db.VarChar
  label        String?   @db.VarChar
  logged       Int?
  readings     Int?
  weeks        Int?
  excluded     Int?
  pending      Int?
  needed       Int?
  llr          Float?
  mean_ev      Float?
  ev_lo        Float?
  ev_hi        Float?
  next_read    String?   @db.VarChar
  payload_json String?

  @@unique([hypothesis, read_date], map: "uq_arm_position_per_read_date")
  @@index([hypothesis], map: "ix_arm_positions_hypothesis")
}

// shortlist_entries (2026-10-15, H-1H-SHORTLIST, website plan PR D): the frozen
// research top 10 of each scheduled card, written once by
// scripts/publish_shortlist.py. Read by raw SQL (lib/shortlist.ts). Hand-added.
model shortlist_entries {
  id                 Int      @id @default(autoincrement())
  card_id            Int
  season             Int
  week               Int
  slot               String   @db.VarChar
  published_at       DateTime @db.Timestamp(6)
  card_built         String?  @db.VarChar
  pool_size          Int?
  method             String?  @db.VarChar
  publication_sha256 String   @db.VarChar
  game_id            Int
  rank               Int
  label              String   @db.VarChar
  payload_json       String

  @@unique([card_id, game_id], map: "uq_shortlist_entry_per_card")
  @@index([card_id], map: "ix_shortlist_entries_card_id")
  @@index([game_id], map: "ix_shortlist_entries_game_id")
  @@index([season], map: "ix_shortlist_entries_season")
}
